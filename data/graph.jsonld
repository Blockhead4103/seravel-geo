  "@graph": [
    {
      "@id": "ai-answer-audit",
      "@type": "Service",
      "name": "KI-Antwort-Audit (AI Answer Audit)",
      "description": "Powered by Seravel. Measures whether AI systems (ChatGPT, Claude, Perplexity, Google Gemini) describe a company and its products correctly, against the client's own approved sources. Two weeks, repeated runs, rates not impressions, each run archived as a baseline. Fixed prices: free Snapshot; Audit CHF 7'500; Audit Regulated CHF 15'000; Monitoring CHF 950 per month. Target groups: pharma, medtech, finance and other regulated industries."
    },
    {
      "@id": "ai-maturity-check",
      "@type": "Service",
      "name": "AI Maturity Check"
    },
    {
      "@id": "assessment",
      "@type": "Service",
      "name": "Assessment",
      "description": "Fixed price after the initial call, two to three weeks. A prioritised basis for decision, including a clear recommendation on what to stop or correct."
    },
    {
      "@id": "fractional-mandate",
      "@type": "Service",
      "name": "Fractional CDO mandate",
      "description": "One to four days a month, six-month minimum term (full-time on request). First the decision (business case with baseline, commission-free vendor choice, an owner from the client's team); then execution of vendors, milestones and sign-offs through to go-live; ends with the handover."
    },
    {
      "@id": "kevin-lancashire",
      "@type": "Person",
      "name": "Kevin Lancashire",
      "jobTitle": "Fractional CDO (interim)",
      "description": "Twenty years of digital platforms, five of them brought live, from migros.ch to roche.com. Thirteen years on the client side with budget, team and vendor accountability. Works on an interim basis: driving decisions, selecting vendors commission-free, executing through to go-live, then the handover. Based in Binningen, Switzerland.",
      "sameAs": [
        "https://www.linkedin.com/in/kevinlancashire"
      ],
