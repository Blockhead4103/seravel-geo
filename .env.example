# Kopiere diese Datei zu .env und trage deine Werte ein.
# Echte Umgebungsvariablen (z. B. in GitHub Actions / Streamlit Secrets)
# haben Vorrang vor .env.

# Anthropic: noetig fuer Extraktion und fuer den Judge im Audit.
ANTHROPIC_API_KEY=
# Modell-ID gegen die aktuelle Anthropic-Doku pruefen. Default claude-opus-5-5.
# Guenstiger und meist ausreichend: claude-sonnet-5-5 oder claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Gemini: optional, nur als zusaetzliche Audit-Engine.
# SDK und Modellname gegen ai.google.dev pruefen.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Website
SITE_NAME=Lancashire Digital
SITE_BASE_URL=https://lancashire-digital.ch

# Kostenbremse: maximale API-Aufrufe je Audit-Lauf (2 je Probe x Engine).
MAX_CALLS_PER_AUDIT=200

# Nur fuer das Online-Dashboard: Passwortschutz. Leer = offener Zugang.
APP_PASSWORD=
